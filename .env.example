# Copier en .env puis adapter. Aucune valeur secrète réelle ici.
# Toute clé de config/config.yaml se surcharge par BIKESHARE_<SECTION>__<CLE>.

BIKESHARE_LOGGING__LEVEL=INFO
BIKESHARE_LOGGING__JSON_FORMAT=true

# Serveur MLflow (depuis l'hôte ; les conteneurs utilisent http://mlflow:5000)
BIKESHARE_MLFLOW__TRACKING_URI=http://localhost:5000

# PostgreSQL de docker compose : identifiants de développement local uniquement
POSTGRES_USER=bikeshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bikeshare
POSTGRES_PORT=5432

# Base applicative vue depuis l'hôte (les conteneurs reçoivent leur propre URL via compose)
BIKESHARE_DATABASE__URL=postgresql+psycopg://bikeshare:change-me@localhost:5432/bikeshare

# Nombre de workers uvicorn de l'API
API_WORKERS=2

# Webhook d'alerte (Slack, Discord…) : secret, ne jamais versionner
BIKESHARE_ALERTS__WEBHOOK_URL=
